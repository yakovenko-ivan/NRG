&equilibrium_validation
  mode = 'all'
  mechanism_file = 'KEROMNES.txt'
  thermo_file = 'KEROMNES_THERMO.txt'
  transport_file = 'KEROMNES_TRANSDATA.txt'

  components_number = 3
  component_species(1) = 'H2'
  component_species(2) = 'O2'
  component_species(3) = 'N2'
  component_moles(1) = 2.0
  component_moles(2) = 1.0
  component_moles(3) = 3.762

  tp_temperature = 1500.0
  initial_temperature = 300.0
  pressure = 101325.0
  crossover_temperature_min = 400.0
  crossover_temperature_max = 3000.0
  output_prefix = 'equilibrium_validation'
/
